rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsRoute(userId, routeId) {
      let routePath = /databases/$(database)/documents/users/$(userId)/routes/$(routeId);
      return signedInAs(userId)
        && exists(routePath)
        && get(routePath).data.ownerId == userId;
    }

    function ownsRouteAfterWrite(userId, routeId) {
      let routePath = /databases/$(database)/documents/users/$(userId)/routes/$(routeId);
      return signedInAs(userId)
        && getAfter(routePath).data.ownerId == userId;
    }

    match /users/{userId}/routes/{routeId} {
      // The route document may not exist yet at the start of a new day.
      // The uid-scoped path is sufficient to authorize its owner to check it.
      allow read: if signedInAs(userId);

      allow create: if signedInAs(userId)
        && request.resource.data.ownerId == userId
        && request.resource.data.keys().hasOnly([
          'ownerId', 'routeDate', 'routeName', 'status', 'stopCount', 'nextSequence',
          'startAddress', 'endAddress', 'endAtLastStop', 'createdAt', 'updatedAt', 'startedAt', 'completedAt', 'isOptimized'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId', 'routeDate', 'routeName', 'status', 'stopCount', 'nextSequence',
          'startAddress', 'endAddress', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.routeDate is string
        && request.resource.data.routeName is string
        && request.resource.data.routeName.size() > 0
        && request.resource.data.routeName.size() <= 60
        && request.resource.data.status == 'active'
        && request.resource.data.stopCount is int
        && request.resource.data.stopCount >= 0
        && request.resource.data.nextSequence is int
        && request.resource.data.nextSequence >= 1
        && request.resource.data.startAddress is string
        && request.resource.data.endAddress is string
        && (!request.resource.data.keys().hasAny(['endAtLastStop']) || request.resource.data.endAtLastStop is bool)
        && request.resource.data.createdAt is timestamp
        && (!request.resource.data.keys().hasAny(['isOptimized']) || request.resource.data.isOptimized is bool)
        && request.resource.data.updatedAt is timestamp;

      allow update: if signedInAs(userId)
        && resource.data.ownerId == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.routeDate == resource.data.routeDate
        && request.resource.data.createdAt == resource.data.createdAt
        && (!request.resource.data.keys().hasAny(['routeName'])
          || (request.resource.data.routeName is string
            && request.resource.data.routeName.size() > 0
            && request.resource.data.routeName.size() <= 60))
        && request.resource.data.keys().hasOnly([
          'ownerId', 'routeDate', 'routeName', 'status', 'stopCount', 'nextSequence',
          'startAddress', 'endAddress', 'endAtLastStop', 'createdAt', 'updatedAt', 'startedAt', 'completedAt', 'isOptimized'
        ])
        && (!request.resource.data.keys().hasAny(['startedAt']) || request.resource.data.startedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['endAtLastStop']) || request.resource.data.endAtLastStop is bool)
        && (!request.resource.data.keys().hasAny(['isOptimized']) || request.resource.data.isOptimized is bool)
        && request.resource.data.status in ['active', 'completed']
        && request.resource.data.stopCount is int
        && request.resource.data.stopCount >= 0
        && request.resource.data.nextSequence is int
        && request.resource.data.nextSequence >= resource.data.nextSequence
        && request.resource.data.updatedAt is timestamp;

      allow delete: if signedInAs(userId) && resource.data.ownerId == userId;

      match /deliveries/{deliveryId} {
        allow read: if ownsRoute(userId, routeId)
          && resource.data.ownerId == userId;

        allow create: if ownsRouteAfterWrite(userId, routeId)
          && request.resource.data.ownerId == userId
          && request.resource.data.keys().hasOnly([
            'ownerId', 'address', 'customerPhone', 'customerName', 'packageCount', 'customerCount', 'recordCount', 'note', 'displayNumber',
            'sequence', 'status', 'failureReason', 'proofPhotoUrl', 'createdAt', 'updatedAt', 'deliveredAt'
          ])
          && request.resource.data.keys().hasAll([
            'ownerId', 'address', 'customerPhone', 'customerName', 'customerCount', 'recordCount', 'note', 'displayNumber', 'sequence', 'status',
            'failureReason', 'proofPhotoUrl', 'createdAt', 'updatedAt', 'deliveredAt'
          ])
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.customerPhone is string
          && request.resource.data.customerPhone.size() <= 30
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() <= 200
          && request.resource.data.customerCount is int
          && request.resource.data.customerCount >= 0
          && request.resource.data.recordCount is int
          && request.resource.data.recordCount >= 0
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.displayNumber is string
          && request.resource.data.displayNumber.size() <= 12
          && request.resource.data.displayNumber.matches('^[0-9]+(\\.[0-9]+)?$')
          && (!request.resource.data.keys().hasAny(['packageCount'])
            || (request.resource.data.packageCount is int && request.resource.data.packageCount >= 1))
          && request.resource.data.sequence is number
          && request.resource.data.sequence > 0
          && request.resource.data.status == 'pending'
          && request.resource.data.failureReason == null
          && request.resource.data.proofPhotoUrl == null
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.deliveredAt == null;

        allow update: if ownsRoute(userId, routeId)
          && resource.data.ownerId == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.address == resource.data.address
          && (!request.resource.data.keys().hasAny(['customerPhone'])
            || (request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() <= 30))
          && (!request.resource.data.keys().hasAny(['customerName'])
            || (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 200))
          && ((!resource.data.keys().hasAny(['packageCount'])
              && !request.resource.data.keys().hasAny(['packageCount']))
            || request.resource.data.packageCount == resource.data.packageCount)
          && ((!resource.data.keys().hasAny(['customerCount'])
              && !request.resource.data.keys().hasAny(['customerCount']))
            || request.resource.data.customerCount == resource.data.customerCount)
          && (!request.resource.data.keys().hasAny(['recordCount'])
            || (request.resource.data.recordCount is int && request.resource.data.recordCount >= 0))
          && request.resource.data.sequence is number
          && request.resource.data.sequence > 0
          && (!request.resource.data.keys().hasAny(['displayNumber'])
            || (request.resource.data.displayNumber is string
              && request.resource.data.displayNumber.size() <= 12
              && request.resource.data.displayNumber.matches('^[0-9]+(\\.[0-9]+)?$')))
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'failureReason', 'proofPhotoUrl', 'updatedAt', 'deliveredAt', 'note', 'sequence', 'displayNumber', 'recordCount', 'customerPhone', 'customerName'
          ])
          && (!request.resource.data.keys().hasAny(['note'])
            || (request.resource.data.note is string && request.resource.data.note.size() <= 300))
          && request.resource.data.status in ['pending', 'delivered', 'failed']
          && request.resource.data.updatedAt is timestamp
          && (request.resource.data.failureReason == null
            || (request.resource.data.failureReason is string
              && request.resource.data.failureReason.size() <= 300))
          && (request.resource.data.proofPhotoUrl == null
            || (request.resource.data.proofPhotoUrl is string
              && request.resource.data.proofPhotoUrl.size() <= 2048))
          && ((request.resource.data.status == 'failed'
              && (request.resource.data.failureReason == null
                || (request.resource.data.failureReason is string
                  && request.resource.data.failureReason.size() > 0))
              && request.resource.data.deliveredAt == null)
            || (request.resource.data.status == 'delivered'
              && request.resource.data.failureReason == null
              && request.resource.data.deliveredAt is timestamp)
            || (request.resource.data.status == 'pending'
              && request.resource.data.failureReason == null
              && request.resource.data.deliveredAt == null));

        allow delete: if ownsRoute(userId, routeId)
          && resource.data.ownerId == userId;
      }
    }

    match /communityAddresses/{addressId} {
      allow read: if request.auth != null;

      // A contributor can create the initial, unverified directory entry only.
      // Credibility and the photo lock are updated by a trusted moderation backend.
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'canonicalAddress', 'address', 'credibilityPercent', 'photosLocked', 'parkingType', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.canonicalAddress is string
        && request.resource.data.canonicalAddress.size() > 0
        && request.resource.data.canonicalAddress.size() <= 500
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 500
        && request.resource.data.credibilityPercent == 0
        && request.resource.data.photosLocked == false
        && request.resource.data.parkingType == 'unknown'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && (resource.data.parkingType == 'unknown' || !resource.data.keys().hasAny(['parkingType']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parkingType', 'updatedAt'])
        && request.resource.data.parkingType in ['street', 'visitor', 'private', 'none']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /contributions/{contributionId} {
        allow read: if request.auth != null
          && (resource.data.status == 'approved' || resource.data.uid == request.auth.uid);
        allow create: if request.auth != null
          && request.auth.token.email_verified == true
          && contributionId == request.auth.uid
          && get(/databases/$(database)/documents/communityAddresses/$(addressId)).data.credibilityPercent < 90
          && get(/databases/$(database)/documents/communityAddresses/$(addressId)).data.photosLocked == false
          && request.resource.data.keys().hasOnly([
            'uid', 'storagePath', 'status', 'latitude', 'longitude', 'accuracyMeters', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.storagePath == 'community/' + addressId + '/' + request.auth.uid + '/photo.jpg'
          && request.resource.data.status == 'pending'
          && (request.resource.data.latitude == null || request.resource.data.latitude is number)
          && (request.resource.data.longitude == null || request.resource.data.longitude is number)
          && (request.resource.data.accuracyMeters == null || request.resource.data.accuracyMeters is number)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null
          && (resource.data.uid == request.auth.uid
            || (resource.data.status == 'active' && resource.data.expiresAt > request.time));
        allow create: if request.auth != null
          && request.auth.token.email_verified == true
          && request.resource.data.keys().hasOnly(['uid', 'text', 'status', 'createdAt', 'expiresAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 280
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
        allow update, delete: if false;
      }
    }

    match /sharedRoutes/{shareId} {
      // Anyone with the unguessable link can view this read-only snapshot until it expires.
      allow get: if resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'name', 'stops', 'isOptimized', 'createdAt', 'expiresAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.isOptimized == true
        && request.resource.data.stops is list
        && request.resource.data.stops.size() > 0
        && request.resource.data.stops.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
